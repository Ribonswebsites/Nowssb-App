# Capacitor / Android — all generated, all rebuildable.
node_modules/
www/
android/
ios/

# Restored repository image pack. Images are intentionally committed so
# the apps can render their visual system offline. Videos remain R2-backed.

# Never commit these. google-services.json identifies the Firebase project to
# the app and is not secret, but the signing keystore and the service-account
# JSON that /api/push uses to talk to FCM absolutely are.
*.keystore
*.jks
*service-account*.json
key.properties

.DS_Store

# Flutter — generated per platform, same rule as android/ and ios/ above.
flutter_app/.dart_tool/
flutter_app/build/
flutter_app/android/
flutter_app/ios/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/pubspec.lock

# The clips inside the Flutter bundle. They are a COPY of assets/video/, put
# there by tools/flutter-assets.mjs on the way into a build — 136 MB that is
# already in this repository once and does not need to be in it twice. Run
# that tool before `flutter pub get`; pub get fails on a declared asset
# directory that does not exist.
flutter_app/assets/video/
flutter_app/assets/frames/
flutter_app/assets/media/
flutter_app/assets/icons/
flutter_app/assets/store/
flutter_app/assets/fashion/
flutter_app/assets/player/
flutter_app/assets/signature/
flutter_app/assets/certificates/
flutter_app/assets/banners/
