# Cloudflare Pages → nowssb (this site) → Settings → Variables and Secrets → Production
# Needed by:
#   functions/api/admin/upload-url.js   (admin media uploads to Cloudflare R2)
#   functions/api/account/upload-url.js (signed-in user avatar uploads; same secrets)
# Names only — never commit real values; add them as encrypted "Secret" variables.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://media.nowssb.com
# Already set for /api/push:
# FIREBASE_PROJECT_ID=nowssb-34f1b
# ADMIN_UIDS=
