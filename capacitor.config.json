{
  "appId": "com.nowssb.app",
  "appName": "NowssB",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https",
    "url": "https://ribonswebsites.github.io/Nowssb-App/"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": []
    },
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "backgroundColor": "#060c18",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "iosSpinnerStyle": "small"
    }
  },
  "ios": {
    "contentInset": "always",
    "limitsNavigationsToAppBoundDomains": true,
    "scheme": "NowssB"
  }
}
