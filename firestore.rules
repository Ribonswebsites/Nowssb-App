rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // An admin is a uid with a document at admins/{uid} (no custom claims
    // needed — works on the free Spark plan). A custom claim admin:true also
    // counts, for accounts marked that way.
    function isAdmin() { return signedIn() && (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || request.auth.token.get('admin', false) == true); }

    // BF-1: paid word payloads live in wordsPrivate/{id}. A signed-in reader
    // may open them when they own the word/meaning, have an active plan, or
    // are an admin. isPro is server-cleared on expiry (Play RTDN / verify).
    function ownedDoc(itemId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/owned/$(itemId);
    }
    function ownsActive(itemId) {
      return signedIn()
        && exists(ownedDoc(itemId))
        && get(ownedDoc(itemId)).data.status == 'active';
    }
    function hasActivePlan() {
      return signedIn()
        && exists(myUserDoc())
        && get(myUserDoc()).data.isPro == true
        && get(myUserDoc()).data.tier in ['resonance', 'frequency', 'frequencyX'];
    }
    function canReadWordsPrivate(id) {
      return isAdmin()
        || ownsActive('word_' + id)
        || ownsActive('signature_' + id)
        || ownsActive('meaning_' + id)
        || hasActivePlan();
    }

    // Fields on users/{uid} that only an admin (or, later, a verified server)
    // may set. A person can still save their profile, prefs, sessions, etc.
    function privilegedUserFields() {
      return ['isPro', 'tier', 'subscription', 'subscriptionStatus', 'subscriptionId', 'subscriptionBilling',
              'subscriptionStartDate', 'subscriptionEndDate', 'subscriptionPaymentId', 'subscriptionExpiresAt',
              'subscriptionPlan', 'subscriptionTier', 'subscriptionUntil', 'plan', 'subUntil', 'entitlement',
              'entitlements', 'blocked', 'blockedAt', 'blockedBy', 'blockedReason', 'removedAt', 'disabled',
              'role', 'roles', 'admin', 'isAdmin', 'coins', 'balance', 'wallet', 'adminGifts',
              'subscriptionOrderId', 'subscriptionSource', 'subscriptionAmount', 'subscriptionCurrency',
              'subscriptionUpdatedAt', 'subscriptionProductId', 'subscriptionTokenHash', 'subscriptionState',
              'subscriptionAutoRenew', 'verifyTier', 'subscriptionGrantedBy', 'restrictions', 'restrictionsUpdatedAt',
              'unblockedAt', 'unblockedBy', 'ebookPassUntil', 'earlyAccessUntil', 'adultConfirmedAt'];
    }
    // isPro:false and tier:null are harmless (a downgrade), so the website's
    // sign-up writes keep working.
    function userFieldsOk(data, changed) {
      return !changed.difference(['isPro', 'tier'].toSet()).hasAny(privilegedUserFields())
        && (!('isPro' in changed) || data.isPro == false)
        && (!('tier' in changed) || data.tier == null)
        && (!('lastSeenAt' in changed) || data.lastSeenAt == request.time);
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    // Admin console restrictions (users/{uid}.restrictions, set only through
    // /api/admin/restrict) and blocks. A missing profile is unrestricted.
    function myUserDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function restricted(key) {
      return exists(myUserDoc()) && (get(myUserDoc()).data.get('blocked', false) == true
        || get(myUserDoc()).data.get('restrictions', {}).get(key, false) == true);
    }
    function isParticipant(chatId) { return signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants; }
    function isCallParty(callId) { return signedIn() && (get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid || get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid); }
    match /admins/{uid} { allow get: if isSelf(uid) || isAdmin(); allow list, write: if false; }
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isAdmin() || (isSelf(uid) && userFieldsOk(request.resource.data, request.resource.data.keys().toSet()));
      allow update: if isAdmin() || (isSelf(uid) && userFieldsOk(request.resource.data, request.resource.data.diff(resource.data).affectedKeys()));
      // In-app account deletion (Play policy): a person may delete their own
      // profile, unless an admin has blocked or restricted it (deleting the
      // doc would otherwise wipe the block). The server delete endpoint
      // (service account) still removes those accounts completely.
      allow delete: if isAdmin() || (isSelf(uid)
        && resource.data.get('blocked', false) != true
        && !('restrictions' in resource.data));
      match /inbox/{msgId} { allow read, delete: if isSelf(uid) || isAdmin(); allow update: if isSelf(uid); allow create: if isAdmin(); }

      // Personal Coach data is private to the signed-in owner.
      match /goals/{goalId} { allow read, write: if isSelf(uid); }
      match /tasks/{taskId} { allow read, write: if isSelf(uid); }
      match /conversations/{messageId} { allow read, write: if isSelf(uid); }
    }
    match /publicProfiles/{uid} {
      allow get, list: if signedIn() && (resource.data.profileVisibility == 'public' || isSelf(uid) || isAdmin());
      allow create: if isSelf(uid) && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid','displayName','username','photoURL','bannerURL','bio','category','link','profileVisibility','updatedAt','createdAt']);
      allow update: if isSelf(uid) && request.resource.data.uid == resource.data.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','username','photoURL','bannerURL','bio','category','link','profileVisibility','updatedAt']);
      allow delete: if isSelf(uid) || isAdmin();
    }
    // Catalogue (library / books / words shelves / meanings cards / quotes).
    // After tools/migrate-words-private.mjs strips paid fields from library
    // items, these docs are free preview only. Paid payloads are NOT stored
    // here — they live in wordsPrivate. Keep world-readable for the store.
    match /content/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /content/{docId}/{sub=**} { allow read: if true; allow write: if isAdmin(); }
    match /requests/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['kind', 'word', 'notes', 'price', 'currency', 'uid', 'email', 'name', 'status', 'at', 'source'])
        && request.resource.data.word is string && request.resource.data.word.size() > 0 && request.resource.data.word.size() <= 80
        && request.resource.data.status == 'new'
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 500))
        && !restricted('requests');
      allow get, list: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Admin mode (Flutter lib/admin). Public words/{key} is the free preview
    // (title, cover, price, locked stubs). Paid fields (meaning, audio/video
    // URLs, stage media) live in wordsPrivate/{key} — see BF-1.
    match /words/{key} { allow read: if true; allow write: if isAdmin(); }
    match /wordsPrivate/{id} {
      allow read: if signedIn() && canReadWordsPrivate(id);
      allow write: if isAdmin();
    }
    match /word_drafts/{key} { allow read, write: if isAdmin(); }
    match /ui_overrides/{id} { allow read: if true; allow write: if isAdmin(); }
    // UI Editor (Admin → UI Editor): page layouts are read by every app;
    // only admins write them. History is admin-only and append-only so a
    // restore can never be rewritten after the fact.
    match /ui_layouts/{id} { allow read: if true; allow write: if isAdmin(); }
    match /ui_history/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
    match /adminLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    // Written only by the server (functions/api/play/*, service account) after
    // Google Play confirms a purchase. A buyer can read their own receipts.
    match /payments/{paymentId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }
    // A phone registers its own push token, only under its own account (or
    // none). Re-binding an existing token is allowed for the device that holds
    // it (same token: an account switch on one phone) — never a new token
    // under someone else's uid, which would receive their pushes.
    match /pushSubs/{id} {
      allow get, list, delete: if isAdmin();
      allow create: if signedIn() && request.resource.data.get('uid', null) in [null, request.auth.uid];
      allow update: if signedIn() && request.resource.data.get('uid', null) in [null, request.auth.uid]
        && (resource.data.get('uid', null) in [null, request.auth.uid]
            || request.resource.data.get('fcmToken', '') == resource.data.get('fcmToken', '-')
            || request.resource.data.get('endpoint', '') == resource.data.get('endpoint', '-'));
    }
    match /posts/{postId} {
      allow get, list: if resource.data.visibility == 'public' || (signedIn() && (resource.data.uid == request.auth.uid || isAdmin()));
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.visibility in ['public','followers'] && !restricted('community');
      allow update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      match /likes/{uid} { allow read: if signedIn(); allow create, delete: if isSelf(uid); allow update: if false; }
      match /comments/{commentId} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.uid == request.auth.uid && !restricted('community'); allow update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()); }
    }
    /* Personal Coach conversation history is private to the signed-in owner.
       This supports the optional Pages endpoint without broadening access to
       other user data. */
    match /users/{uid}/coachConversations/{conversationId} {
      allow read, create, update, delete: if isSelf(uid);
      match /messages/{messageId} {
        allow read, create, update, delete: if isSelf(uid);
      }
    }

    match /stories/{storyId} { allow get, list: if resource.data.visibility == 'public' || (signedIn() && resource.data.uid == request.auth.uid); allow create: if signedIn() && request.resource.data.uid == request.auth.uid && !restricted('community'); allow update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()); }
    match /follows/{uid}/following/{targetUid} { allow read: if signedIn(); allow create, delete: if isSelf(uid) && targetUid != request.auth.uid; allow update: if false; }
    match /follows/{uid}/followers/{followerUid} { allow read: if signedIn(); allow create, delete: if isSelf(followerUid) && uid != request.auth.uid; allow update: if false; }
    match /chats/{chatId} {
      allow get: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.resource.data.participants is list && request.resource.data.participants.size() == 2 && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;
      match /messages/{messageId} { allow read: if isParticipant(chatId); allow create: if isParticipant(chatId) && request.resource.data.from == request.auth.uid; allow update, delete: if isParticipant(chatId) && resource.data.from == request.auth.uid; }
    }
    match /calls/{callId} {
      allow get: if signedIn() && (resource.data.callerUid == request.auth.uid || resource.data.calleeUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.callerUid == request.auth.uid && request.resource.data.calleeUid is string && request.resource.data.calleeUid != request.auth.uid;
      allow update: if isCallParty(callId); allow delete: if isCallParty(callId);
      match /{sub=**} { allow read, write: if isCallParty(callId); }
    }
    match /blocks/{uid}/blocked/{blockedUid} { allow read: if isSelf(uid); allow create, delete: if isSelf(uid) && blockedUid != request.auth.uid; allow update: if false; }
    match /reports/{reportId} { allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid; allow get: if isAdmin() || (signedIn() && resource.data.reporterUid == request.auth.uid); allow list: if isAdmin() || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow update, delete: if isAdmin(); }

    // Economy. Balances, ledgers, listings, and payouts are written only by
    // Cloud Functions (Admin SDK). Clients may read what they own.
    function ownsLedger() {
      return signedIn() && resource.data.uid == request.auth.uid;
    }
    function adminWalletOk(keys) {
      return keys.hasOnly(['coins', 'streak', 'lifetimeEarned', 'lastLoginYmd', 'updatedAt', 'streakResetAt', 'lastBrokenStreak'])
        && request.resource.data.get('coins', 0) is int && request.resource.data.get('coins', 0) >= 0;
    }
    match /users/{uid}/wallet/{docId} {
      allow read: if isSelf(uid) || isAdmin();
      // Admin console (when the server key is not set): coins/streak only,
      // always paired with an append-only coinLedger row.
      allow create: if isAdmin() && docId == 'main' && adminWalletOk(request.resource.data.keys());
      allow update: if isAdmin() && docId == 'main' && adminWalletOk(request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if false;
    }
    match /users/{uid}/referral/{docId} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }
    match /users/{uid}/sellerStats/{docId} {
      allow read: if isSelf(uid);
      allow write: if false;
    }
    match /users/{uid}/payout/{docId} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isAdmin() && docId == 'main';
      allow delete: if false;
    }
    match /users/{uid}/partner/{docId} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }
    match /users/{uid}/owned/{itemId} {
      allow read: if isSelf(uid) || isAdmin();
      // Purchases are written by /api/play/verify; an admin may grant or
      // revoke an item from the console (always marked source 'admin').
      allow create, update: if isAdmin() && request.resource.data.source == 'admin'
        && request.resource.data.status in ['active', 'revoked'];
      allow delete: if false;
    }
    match /users/{uid}/earnCaps/{day} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }
    match /users/{uid}/quests/{questId} {
      allow read: if isSelf(uid);
      allow write: if false;
    }
    // Practice days per word (written by the economy server); the app reads
    // them to restore this account's practice history on a new install.
    match /users/{uid}/mastery/{wordId} {
      allow read: if isSelf(uid);
      allow write: if false;
    }
    match /users/{uid}/milestones/{wordId} {
      allow read: if isSelf(uid);
      allow write: if false;
    }
    // The Store wishlist, synced across phones. Owner only, small docs.
    match /users/{uid}/wishlist/{itemId} {
      allow read, delete: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['id', 'title', 'subtitle', 'image', 'price', 'kind', 'addedAt'])
        && request.resource.data.id is string && request.resource.data.id.size() <= 200;
    }
    // NowssB programs (Earn · Rewards · Coupons · Gifts · Reference · Partner).
    // Written only by the Cloudflare Pages Functions in functions/api/economy
    // (service account); the owner can read their own.
    match /users/{uid}/{econ}/{docId} {
      allow read: if isSelf(uid) && econ in ['weeks', 'months', 'scratchCards', 'coupons', 'tokens', 'boxes', 'passes',
        'giftsSent', 'giftsReceived', 'mastery', 'friends', 'team', 'blocks'];
      allow write: if false;
    }
    match /commissionLedger/{id} {
      allow get, list: if ownsLedger() || isAdmin();
      allow write: if false;
    }
    match /partnerLedger/{id} {
      allow get, list: if ownsLedger() || isAdmin();
      allow write: if false;
    }
    match /checkouts/{id} {
      allow get, list: if ownsLedger() || isAdmin();
      allow write: if false;
    }
    match /sales/{orderId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.buyerUid == request.auth.uid);
      allow write: if false;
    }
    match /giftCards/{code} {
      allow get, list: if isAdmin() || (signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.redeemedBy == request.auth.uid));
      allow write: if false;
    }
    match /refLinks/{code} {
      allow get, list: if isAdmin() || ownsLedger();
      allow write: if false;
    }
    match /appointments/{id} {
      allow get, list: if isAdmin() || (signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid));
      allow write: if false;
    }
    match /leaderboards/{id} { allow read: if signedIn(); allow write: if false; }
    // League boards hold uids; players see ranks only through /api/economy/league
    // (display aliases). Entries live in leagues/{week_tier}/entries/{uid}.
    match /leagues/{id} { allow read: if isAdmin(); allow write: if false; }
    match /leagues/{id}/entries/{uid} { allow read: if isAdmin(); allow write: if false; }
    match /echoLikes/{id} { allow get: if ownsLedger(); allow list: if ownsLedger(); allow write: if false; }
    // devices, payoutIdentities, accountIndex, refOpens: server only (catch-all deny).

    match /users/{uid}/notifications/{id} {
      allow read: if isSelf(uid);
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create: if isAdmin();
      // "Clear all" in the inbox, and account deletion.
      allow delete: if isSelf(uid) || isAdmin();
    }
    match /users/{uid}/prefs/{docId} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid)
        && docId == 'earn'
        && request.resource.data.keys().hasOnly(['hasSeenEarnCard', 'earnCardLastShownAt'])
        && request.resource.data.hasSeenEarnCard == true;
      allow delete: if false;
    }
    match /coinLedger/{entryId} {
      allow get: if ownsLedger() || isAdmin();
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      // Append-only. An admin adjustment names the admin and says why.
      allow create: if isAdmin() && request.resource.data.by == request.auth.token.email
        && request.resource.data.delta is int && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0 && request.resource.data.reason.size() <= 200;
      allow update, delete: if false;
    }
    match /referralLedger/{entryId} {
      allow get: if isAdmin() || (signedIn() && (resource.data.referrerUid == request.auth.uid || resource.data.referredUid == request.auth.uid));
      allow list: if isAdmin() || (signedIn() && (resource.data.referrerUid == request.auth.uid || resource.data.referredUid == request.auth.uid));
      allow write: if false;
    }
    match /cashLedger/{entryId} {
      allow get: if ownsLedger() || isAdmin();
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if isAdmin() && request.resource.data.delta is int;
      allow update, delete: if false;
    }
    match /playReceipts/{receiptId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    match /listings/{listingId} {
      allow get, list: if resource.data.status == 'live' || (signedIn() && (resource.data.sellerUid == request.auth.uid || isAdmin()));
      allow write: if false;
    }
    match /sellerProfiles/{uid} {
      allow get: if true;
      allow list: if true;
      allow write: if false;
    }
    match /resaleReviews/{reviewId} {
      allow get, list: if resource.data.status == 'live';
      allow write: if false;
    }
    match /referralCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if false;
    }
    match /payoutRequests/{id} {
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      // Manual UPI queue: an admin moves a request along; amount/owner never change.
      allow update: if isAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.amountBase == resource.data.amountBase
        && request.resource.data.status in ['approved', 'paid', 'rejected'];
      allow create, delete: if false;
    }
    // Gifts, coupons, referral network: written by the economy server; the
    // admin console reads them and issues / voids gift codes.
    match /gifts/{code} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.source == 'admin' && request.resource.data.status == 'unredeemed';
      allow update: if isAdmin() && resource.data.status == 'unredeemed'
        && request.resource.data.status == 'void'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'voidedBy', 'voidedAt']);
      allow delete: if false;
    }
    match /giftLedger/{id} { allow read: if isAdmin(); allow create: if isAdmin() && request.resource.data.source == 'admin'; allow update, delete: if false; }
    match /couponLedger/{id} { allow read: if isAdmin(); allow write: if false; }
    match /referrals/{refereeUid} { allow read: if isAdmin(); allow write: if false; }
    // Word Print. Public document holds only public fields. Money stays under
    // /users/{uid}/wallet and /users/{uid}/payout, which other accounts cannot read.
    match /profiles/{uid} {
      allow get: if true;
      allow list: if true;
      allow create, update, delete: if false;
    }
    match /echoPosts/{postId} {
      allow get, list: if resource.data.status == 'live' || (signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin()));
      allow write: if false;
    }
    match /echoComments/{commentId} {
      allow get, list: if resource.data.status == 'live' || (signedIn() && (resource.data.authorUid == request.auth.uid || isAdmin()));
      allow write: if false;
    }
    match /echoReports/{reportId} {
      allow create: if false;
      allow get, list: if isAdmin() || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow update, delete: if false;
    }
    // config/app (force update, maintenance, feature flags, announcement)
    // is read before sign-in too; config/economy and the rest need a sign-in.
    match /config/{docId} {
      allow read: if signedIn() || docId == 'app' || docId == 'store';
      allow write: if isAdmin();
    }
    // Every settings save from the admin console, append-only.
    match /configHistory/{id} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }
    // Activity feed. The app may add only its own sign-in / sign-up / open
    // event, stamped with the server clock; the admin server writes the rest.
    match /activity/{id} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['login', 'signup', 'open']
        && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['type', 'uid', 'at', 'platform', 'build', 'app', 'summary']);
      allow update, delete: if false;
    }
    // Daily sign-ins (Admin app: "who signed in today", a person's sign-in
    // days). The app writes its own row for the India-time day, stamped with
    // the server clock; only admins read the day list. Nobody deletes except
    // the owner (account deletion) or an admin.
    function presenceDayOk(uid, day) {
      return isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.day == day
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.last == request.time
        && request.resource.data.keys().hasOnly(['uid', 'day', 'first', 'last', 'opens', 'platform', 'build', 'os', 'email', 'name'])
        && (!('opens' in request.resource.data) || request.resource.data.opens is int)
        && (!('os' in request.resource.data) || (request.resource.data.os is string && request.resource.data.os.size() <= 80));
    }
    match /presenceDays/{day} {
      allow read: if isAdmin();
      allow write: if false;
      match /people/{uid} {
        allow read: if isAdmin();
        allow create, update: if presenceDayOk(uid, day);
        allow delete: if isSelf(uid) || isAdmin();
      }
    }
    match /users/{uid}/days/{day} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if presenceDayOk(uid, day);
      allow delete: if isSelf(uid) || isAdmin();
    }
    // Admin inbox (new requests, payouts, purchases, sign-ups, feedback).
    // Raised by the server only; admins may mark them seen.
    match /adminAlerts/{id} {
      allow read: if isAdmin();
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'seenAt', 'seenBy']);
      allow create, delete: if false;
    }
    // Push broadcasts sent from the console (written by /api/admin/broadcast).
    match /broadcasts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Progress-page feedback. A person adds their own; admins read it.
    match /feedback/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'rating', 'tags', 'text', 'source', 'platform', 'at', 'status'])
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.status == 'new'
        && request.resource.data.at == request.time;
      allow read, update, delete: if isAdmin();
    }
    // Account deletion queue (when the server cannot delete the Auth
    // account itself). One request per person; admins process it.
    match /accountDeletionRequests/{uid} {
      allow create: if isSelf(uid) && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'reason', 'status', 'requestedAt', 'platform'])
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt == request.time;
      allow get: if isSelf(uid) || isAdmin();
      allow list, update, delete: if isAdmin();
    }

    match /ratings/{uid}/entries/{raterUid} { allow read: if signedIn(); allow create, update: if isSelf(raterUid) && uid != request.auth.uid; allow delete: if isSelf(raterUid) || isAdmin(); }
    match /reels/{id} { allow read: if true; allow create: if signedIn() && request.resource.data.uid == request.auth.uid && !restricted('community'); allow update, delete: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin()); }
    match /{document=**} { allow read, write: if false; }
  }
}
