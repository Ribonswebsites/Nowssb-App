rules_version = '2';

/* NowssB Firestore security rules.
 *
 * Private account data stays in users/{uid}. Connect discovery uses the small
 * publicProfiles/{uid} projection. Social writes are limited to the signed-in
 * author and conversation/call participants; moderation can use admins/{uid}.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isParticipant(chatId) {
      return signedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    function isCallParty(callId) {
      return signedIn() &&
        (get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid ||
         get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid);
    }

    match /admins/{uid} {
      allow get: if isSelf(uid) || isAdmin();
      allow list, write: if false;
    }

    /* Private account and app-state document. */
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if isSelf(uid) || isAdmin();
      allow delete: if isAdmin();

      match /inbox/{msgId} {
        allow read, delete: if isSelf(uid) || isAdmin();
        allow update: if isSelf(uid);
        allow create: if isAdmin();
      }
    }

    /* Deliberately non-sensitive projection used by signed-in Connect search. */
    match /publicProfiles/{uid} {
      allow get, list: if signedIn() &&
        (resource.data.profileVisibility == 'public' || isSelf(uid) || isAdmin());
      allow create: if isSelf(uid) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'photoURL', 'bannerURL',
          'bio', 'category', 'link', 'profileVisibility', 'updatedAt', 'createdAt'
        ]);
      allow update: if isSelf(uid) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'username', 'photoURL', 'bannerURL', 'bio', 'category',
          'link', 'profileVisibility', 'updatedAt'
        ]);
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /content/{docId}/{sub=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /requests/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow get: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list, update, delete: if isAdmin();
    }

    match /pushSubs/{id} {
      allow get, list, delete: if isAdmin();
      allow create, update: if signedIn();
    }

    /* Public Connect posts. */
    match /posts/{postId} {
      allow get, list: if resource.data.visibility == 'public' ||
        (signedIn() && (resource.data.uid == request.auth.uid || isAdmin()));
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.visibility in ['public', 'followers'];
      allow update, delete: if signedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());

      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if isSelf(uid);
        allow update: if false;
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if signedIn() &&
          (resource.data.uid == request.auth.uid || isAdmin());
      }
    }

    /* 24-hour stories. */
    match /stories/{storyId} {
      allow get, list: if resource.data.visibility == 'public' ||
        (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());
    }

    /* Following graph. A signed-in user may see counts and profiles, but can
       only create/delete edges where they are the acting user. */
    match /follows/{uid}/following/{targetUid} {
      allow read: if signedIn();
      allow create, delete: if isSelf(uid) && targetUid != request.auth.uid;
      allow update: if false;
    }
    match /follows/{uid}/followers/{followerUid} {
      allow read: if signedIn();
      allow create, delete: if isSelf(followerUid) && uid != request.auth.uid;
      allow update: if false;
    }

    /* Two-person conversations. The parent document is the access boundary. */
    match /chats/{chatId} {
      allow get: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() &&
        request.resource.data.participants is list &&
        request.resource.data.participants.size() == 2 &&
        request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;
      allow delete: if signedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if isParticipant(chatId);
        allow create: if isParticipant(chatId) &&
          request.resource.data.from == request.auth.uid;
        allow update, delete: if isParticipant(chatId) &&
          resource.data.from == request.auth.uid;
      }
    }

    /* WebRTC signaling documents are private to the two call parties. */
    match /calls/{callId} {
      allow get: if signedIn() &&
        (resource.data.callerUid == request.auth.uid || resource.data.calleeUid == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.callerUid == request.auth.uid &&
        request.resource.data.calleeUid is string &&
        request.resource.data.calleeUid != request.auth.uid;
      allow update: if isCallParty(callId);
      allow delete: if isCallParty(callId);
      match /{sub=**} {
        allow read, write: if isCallParty(callId);
      }
    }

    match /blocks/{uid}/blocked/{blockedUid} {
      allow read: if isSelf(uid);
      allow create, delete: if isSelf(uid) && blockedUid != request.auth.uid;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow get: if isAdmin() || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow list: if isAdmin() || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /ratings/{uid}/entries/{raterUid} {
      allow read: if signedIn();
      allow create, update: if isSelf(raterUid) && uid != request.auth.uid;
      allow delete: if isSelf(raterUid) || isAdmin();
    }

    match /reels/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() &&
        (resource.data.uid == request.auth.uid || isAdmin());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
